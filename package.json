{
  "name": "nervbox-mixer",
  "version": "0.6.8",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o --allowed-hosts=all",
    "build": "ng build",
    "build:prod": "ng build --configuration production --output-hashing=all --source-map=false --optimization=true",
    "build:lan": "ng build --configuration lan",
    "start:lan": "ng serve --configuration lan --host 0.0.0.0 --allowed-hosts=all",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "scan-sounds": "node scripts/scan-sounds.js",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@breezystack/lamejs": "^1.2.7",
    "bungee-pitch-shift": "^1.0.8",
    "pitchfinder": "^2.3.4",
    "rxjs": "^7.8.1",
    "tone": "^15.1.22",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "music-metadata": "^13.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
